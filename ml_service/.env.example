# Copia este archivo a .env (misma carpeta que este Dockerfile) y
# completa los valores reales. .env NUNCA debe subirse al repositorio.

# --- Data Service (RF39, RF41) -----------------------------------------
# Dentro de la red de docker-compose, el host es el NOMBRE DEL SERVICIO
# ("data_service"), no "localhost".
DATA_SERVICE_BASE_URL=http://data_service:8000
DATA_SERVICE_PAIR_CODE=SP500_VIX
INTERNAL_SERVICE_KEY=b01a9dd282e259ea0ef394ca41b598a68d028806bf7e657ad0296396305b845e
HTTP_TIMEOUT_SECONDS=5
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=1

# --- API propia del ML Service (RF41) -----------------------------------
ML_SERVICE_API_KEY=63a31109a128018bfe735ee13b683aaf2eb3dd45ea90f950304f9c2a47a72af4
REQUIRE_API_KEY=true

# --- MLflow (Model Registry, RF43) --------------------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=sp500_volatility
MLFLOW_REGISTERED_MODEL_NAME=sp500_range_predictor
MLFLOW_MONITORING_RUN_NAME=production_monitoring

# --- SQLite de predicciones (volumen Docker) ----------------------------
PREDICTIONS_DB_PATH=/app/data/predictions.db

# --- Export histórico (backtest 2022 -> actualidad) ---------------------
HISTORICAL_BACKTEST_START=2022-01-01
HISTORICAL_BACKTEST_OUTPUT_DIR=/app/data/exports

# --- Respaldo local de modelo (RNF04) ------------------------------------
MODEL_LOCAL_DIR=/app/data/models

# --- Scheduler interno (RF08: reentrenamiento el día 1 de cada mes) -----
RETRAIN_SCHEDULE_DAY=1
RETRAIN_SCHEDULE_HOUR=3
RETRAIN_SCHEDULE_MINUTE=0
RETRAIN_SCHEDULE_TIMEZONE=America/Bogota
SCHEDULER_ENABLED=true

# --- Logging (RNF19) ------------------------------------------------------
ML_SERVICE_LOG_DIR=/app/logs

# --- Walk-Forward Validation ----------------------------------------------
WF_MIN_TRAIN_DAYS=252
WF_STEP_DAYS=21
